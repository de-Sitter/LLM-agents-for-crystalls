# Copy to .env and replace placeholders. Never commit .env.
LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
LLM_API_KEY=replace-with-api-key
LLM_MODEL=replace-with-model-name
LLM_STREAM=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120
LLM_RETRIES=10

# Optional local installations used by full MatterGen/evaluator runs.
MATTERGEN_ROOT=external/mattergen
MATTERGEN_VENV=.venv-mattergen
MATTERGEN_MODEL_PATH=external/mattergen/checkpoints/chemical_system_energy_above_hull
EVALUATOR_DIR=external/evaluator

